MEMBERSHIP_DURATION_DAYS=365
LOAN_DURATION_DAYS=14
MAX_ACTIVE_LOANS_PER_MEMBER=5
RESERVATION_HOLD_DAYS=3
MAX_BOOK_FILE_SIZE_MB=50
STORAGE_ROOT=../storage
AI_PROVIDER=openai-compatible
AI_API_KEY=
AI_MODEL=
