APP_NAME=Litera
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/nama_db
JWT_SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
